.DS_Store
# Claude Code orchestration (transient; produced by .claude/scripts/spawn-worker.sh)
.claude/orchestration-logs/
# Worker worktrees live OUTSIDE .claude/, which Claude Code protects — a worker
# sandboxed under it is refused every write, silently. See spawn-worker.sh.
.worktrees/
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
# The video index and transcript cache are local-only and never enter git
# (docs/DESIGN.md R21).
data/
