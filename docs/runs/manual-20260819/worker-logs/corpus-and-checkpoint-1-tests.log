"""Blind tests for ``find_best_mobo.config`` (corpus-and-checkpoint, slice 1).

Written from the slice specification alone, in parallel with the
implementation and without access to it. Expected defaults below are the ones
pinned by ``docs/DESIGN.md`` (R4, R5, R24) and the plan's recorded rulings.
"""

from dataclasses import FrozenInstanceError
from datetime import date
from pathlib import Path

import pytest

from find_best_mobo.config import load_config

FULL_TOML = """\
channel_url = "https://example.invalid/@SomeOtherChannel/videos"
start_date = 2023-02-03
data_dir = "elsewhere"
shorts_max_seconds = 95
mention_threshold = 4
window_before_seconds = 60
window_after_seconds = 240
per_video_excerpt_cap = 7
bundle_token_cap = 25000
calibration_batch_size = 12
batch_count = 5
chars_per_token = 3.5
consecutive_fetch_error_limit = 2
fetch_error_rate_limit = 0.02
missing_caption_rate_limit = 0.07
"""


def write_toml(tmp_path: Path, body: str) -> Path:
    path = tmp_path / "config.toml"
    path.write_text(body, encoding="utf-8")
    return path


def test_load_config_reads_every_key(tmp_path: Path) -> None:
    config = load_config(write_toml(tmp_path, FULL_TOML))
    assert config.channel_url == "https://example.invalid/@SomeOtherChannel/videos"
    assert config.start_date == date(2023, 2, 3)
    assert isinstance(config.data_dir, Path)
    assert config.data_dir.name == "elsewhere"
    assert config.shorts_max_seconds == 95
    assert config.mention_threshold == 4
    assert config.window_before_seconds == 60
    assert config.window_after_seconds == 240
    assert config.per_video_excerpt_cap == 7
    assert config.bundle_token_cap == 25000
    assert config.calibration_batch_size == 12
    assert config.batch_count == 5
    assert config.chars_per_token == pytest.approx(3.5)
    assert config.consecutive_fetch_error_limit == 2
    assert config.fetch_error_rate_limit == pytest.approx(0.02)
    assert config.missing_caption_rate_limit == pytest.approx(0.07)


def test_load_config_empty_file_yields_documented_defaults(tmp_path: Path) -> None:
    """An absent key is never a crash: in-code defaults fill every field.

    Only defaults actually pinned by the design doc or a recorded ruling are
    asserted exactly; ``shorts_max_seconds`` is only "~2 minutes" in the plan,
    so it gets a sanity range rather than a number the spec never stated.
    """
    config = load_config(write_toml(tmp_path, ""))
    assert config.start_date == date(2023, 1, 1)
    assert config.mention_threshold == 3
    assert config.window_before_seconds == 120
    assert config.window_after_seconds == 300
    assert config.consecutive_fetch_error_limit == 3
    assert config.fetch_error_rate_limit == pytest.approx(0.03)
    assert config.missing_caption_rate_limit == pytest.approx(0.05)
    assert config.chars_per_token == pytest.approx(4.0)
    assert 30 <= config.shorts_max_seconds <= 180
    assert isinstance(config.data_dir, Path)
    assert isinstance(config.start_date, date)
    assert "youtube.com" in config.channel_url


def test_load_config_partial_file_keeps_defaults_for_absent_keys(tmp_path: Path) -> None:
    body = "mention_threshold = 5\nshorts_max_seconds = 90\n"
    config = load_config(write_toml(tmp_path, body))
    assert config.mention_threshold == 5
    assert config.shorts_max_seconds == 90
    assert config.start_date == date(2023, 1, 1)
    assert config.window_after_seconds == 300


def test_config_is_frozen(tmp_path: Path) -> None:
    config = load_config(write_toml(tmp_path, ""))
    with pytest.raises(FrozenInstanceError):
        config.mention_threshold = 9  # type: ignore[misc]
```

